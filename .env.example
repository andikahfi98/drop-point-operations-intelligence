# Copy to .env for a local installation. Never commit .env.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=drop_point_ops
DB_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-local-password
SIMULATION_API_KEY=replace-with-random-internal-key

# OpenAI-compatible provider used by the Telegram AI route.
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-model-id
LLM_FAST_MODEL=replace-with-fast-model-id

# Telegram: create a bot with BotFather, then register its webhook.
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_REGIONAL_CHAT_IDS=replace-with-regional-chat-id
TELEGRAM_REGIONAL_USER_ID=replace-with-regional-manager-user-id
N8N_WEBHOOK_URL=https://replace-with-your-ngrok-domain.ngrok-free.dev/
N8N_PROXY_HOPS=1

# Used only for local demo account provisioning.
DEMO_MANAGER_PASSWORD=replace-with-temporary-demo-password
